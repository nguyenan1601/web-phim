# Supabase Configuration
# Copy this file to .env and fill in your own Supabase project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: use an external backend/proxy for NguonC in production if Vercel is blocked.
# Mirror mode: endpoint should expose the same paths as https://phim.nguonc.com/api.
NGUONC_API_BASE=https://phim.nguonc.com/api

# Generic proxy mode: endpoint should accept ?url=<encoded upstream url>.
# NGUONC_API_PROXY_URL=https://your-proxy.example.com/api/proxy
